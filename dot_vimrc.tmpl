" ~/.vimrc — managed by chezmoi
" Source: https://github.com/frenshape/dotfiles
" One file, works on macOS (MacVim), Windows (gVim), and Linux.

call plug#begin()

Plug 'preservim/vim-markdown'
Plug 'iamcco/markdown-preview.nvim', { 'do': 'cd app && yarn install' }
Plug 'davidhalter/jedi-vim'
Plug 'vim-python/python-syntax'
Plug 'dense-analysis/ale'
Plug 'preservim/nerdtree'
Plug 'tpope/vim-fugitive'
Plug 'junegunn/fzf.vim'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-commentary'
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'Vimjas/vim-python-pep8-indent'
Plug 'dhruvasagar/vim-table-mode'
Plug 'editorconfig/editorconfig-vim'
{{- if eq .profile "full" }}
Plug 'lervag/vimtex',                { 'tag': 'v2.18' }
{{- end }}

call plug#end()

" --- General ---
syntax on
filetype plugin indent on
set number
set expandtab shiftwidth=2 tabstop=2
set incsearch hlsearch
set nocompatible

" --- Python ---
let g:python_highlight_all = 1
let g:ale_linters = {'python': ['flake8', 'pylint']}
let g:ale_fixers  = {'python': ['black']}
let g:ale_fix_on_save = 1

" --- Markdown ---
let g:vim_markdown_folding_disabled = 1

" --- NERDTree ---
nnoremap <C-n> :NERDTreeToggle<CR>

" --- fzf.vim (uses the system fzf binary, installed via package manager) ---
nnoremap <C-p> :Files<CR>
nnoremap <leader>g :Rg<CR>
nnoremap <leader>b :Buffers<CR>

" --- vim-fugitive ---
nnoremap <leader>gs :Git<CR>
nnoremap <leader>gd :Gdiffsplit<CR>

" --- vim-airline ---
let g:airline#extensions#ale#enabled = 1
set laststatus=2

" --- vim-table-mode (pipe-style tables to match Markdown, not org-mode) ---
let g:table_mode_corner = '|'

" --- LaTeX (vimtex) ---
{{- if eq .profile "full" }}
" PDF viewer differs by OS — vimtex picks the right one automatically here.
if has('macunix')
  let g:vimtex_view_method = 'skim'
elseif has('win32')
  let g:vimtex_view_method = 'sumatrapdf'
else
  let g:vimtex_view_method = 'zathura'
endif
{{- end }}
