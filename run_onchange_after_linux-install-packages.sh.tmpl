{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

sudo apt update
xargs -a "$HOME/.apt-packages.txt" sudo env DEBIAN_FRONTEND=noninteractive apt install -y

# uv + pre-commit — not an apt package, installed via the official script.
# Available in both profiles since it's lightweight, general dev tooling.
if ! command -v uv &>/dev/null; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"
uv tool install pre-commit

# micromamba — single binary, no bundled base env. Installed in both
# profiles so it's ready to use; the heavier scipy/Jupyter `work` env
# (below) is still full-profile-only.
if ! command -v micromamba &>/dev/null; then
  bash <(curl -L micro.mamba.pm/install.sh)
fi
export MAMBA_ROOT_PREFIX="$HOME/micromamba"

{{- if eq .profile "full" }}
sudo usermod -aG docker "$(whoami)"   # takes effect on next login

command -v corepack &>/dev/null || sudo npm install -g corepack
corepack enable
corepack prepare yarn@stable --activate

if micromamba env list 2>/dev/null | grep -qw work; then
  micromamba install -y -n work -f "$HOME/environment.yml"
else
  micromamba create -y -n work -f "$HOME/environment.yml"
fi
{{- end }}

mkdir -p ~/.vim/autoload
curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

vim +PlugInstall +qall

MDP_APP="$HOME/.vim/plugged/markdown-preview.nvim/app"
if [ -d "$MDP_APP" ] && [ ! -d "$MDP_APP/node_modules" ] && command -v yarn &>/dev/null; then
  (cd "$MDP_APP" && yarn install)
fi
{{ end -}}
