{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# vimrc hash (forces this script to re-run whenever plugins change):
# {{ include "dot_vimrc.tmpl" | sha256sum }}
set -euo pipefail

if ! command -v brew &>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

brew bundle --file="$HOME/.Brewfile"

# pre-commit — installed via `uv tool install`, which keeps it isolated
# from any project virtualenv or the micromamba `work` env.
uv tool install pre-commit

# micromamba — single binary, no bundled base env, replaces the old
# miniforge cask install for a lighter footprint.
export MAMBA_ROOT_PREFIX="$HOME/micromamba"
if micromamba env list 2>/dev/null | grep -qw work; then
  micromamba install -y -n work -f "$HOME/environment.yml"
else
  micromamba create -y -n work -f "$HOME/environment.yml"
fi

mkdir -p ~/.vim/autoload
curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim

vim +PlugInstall +qall

# markdown-preview.nvim's own build step only runs on vim-plug's initial
# clone, not on repeat :PlugInstall runs — so if it ever fails once, it
# stays broken forever unless checked explicitly like this.
MDP_APP="$HOME/.vim/plugged/markdown-preview.nvim/app"
if [ -d "$MDP_APP" ] && [ ! -d "$MDP_APP/node_modules" ] && command -v yarn &>/dev/null; then
  (cd "$MDP_APP" && yarn install)
fi
{{ end -}}
