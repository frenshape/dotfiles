{{ if eq .chezmoi.os "windows" -}}
$packages = @(
    "vim.vim",
    "BurntSushi.ripgrep.MSVC",
    "junegunn.fzf"
)
{{- if eq .profile "full" }}
$packages += @(
    "MiKTeX.MiKTeX",
    "OpenJS.NodeJS",
    "Yarn.Yarn",
    "Docker.DockerDesktop"
)
{{- end }}
foreach ($pkg in $packages) {
    winget install --id $pkg --accept-package-agreements --accept-source-agreements -e
}

# Refresh PATH from the registry so packages winget just installed (and
# their PATH registration) are visible in this same script session,
# without needing a new shell.
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + `
            [System.Environment]::GetEnvironmentVariable("Path", "User")

# uv + pre-commit
winget install --id astral-sh.uv --accept-package-agreements --accept-source-agreements -e
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + `
            [System.Environment]::GetEnvironmentVariable("Path", "User")
uv tool install pre-commit

# micromamba — installed in both profiles so it's ready to use; the
# heavier scipy/Jupyter `work` env (below) is still full-profile-only.
winget install --id Mamba.Micromamba --accept-package-agreements --accept-source-agreements -e
$env:MAMBA_ROOT_PREFIX = "$env:USERPROFILE\micromamba"

{{- if eq .profile "full" }}
$existing = & micromamba env list 2>$null | Select-String '\bwork\b'
if ($existing) {
    micromamba install -y -n work -f "$env:USERPROFILE\environment.yml"
} else {
    micromamba create -y -n work -f "$env:USERPROFILE\environment.yml"
}
{{- end }}

$plugDir = "$env:USERPROFILE\vimfiles\autoload"
New-Item -ItemType Directory -Force -Path $plugDir | Out-Null
Invoke-WebRequest -Uri "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim" -OutFile "$plugDir\plug.vim"

vim +PlugInstall +qall
{{ end -}}
